# Postgres password for the bundled database.
POSTGRES_PASSWORD=

# Public URL people open, used in emails and tool sign-in callbacks.
LOOPER_URL=https://looper.internal.example.com
LOOPER_PORT=3000

# Any long random string. Encrypts model and connector keys at rest. Never change it after the first sign in.
ENCRYPTION_KEY=
# The scheduler sends this to /api/cron/tick.
CRON_SECRET=

# Sign-in codes and notifications through your mail server.
SMTP_URL=smtp://user:password@smtp.example.com:587
SMTP_FROM=Looper <looper@example.com>

# Custom connectors may call hosts inside your network.
LOOPER_ALLOW_PRIVATE_HOSTS=1

# Optional: tools through Composio (needs outbound HTTPS to backend.composio.dev).
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIGS=

# Only these email domains can create an account (comma separated). Invites still work for anyone you add.
LOOPER_ALLOWED_EMAILS=@example.com
