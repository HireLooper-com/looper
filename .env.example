# Postgres. Tables are created on first use. Neon URLs use the Neon HTTP driver, any other URL node-postgres.
DATABASE_URL=
# Optional: neon or pg, to override the driver the URL picks.
DATABASE_DRIVER=

# Any long random string. Encrypts model API keys at rest. Never change it after launch.
ENCRYPTION_KEY=

# Loops, for sign in codes. Without a key, codes print to the server log (local only).
LOOPS_API_KEY=
# Id of the one generic Loops transactional template. Data variables: subject, heading, body.
LOOPS_TEMPLATE_ID=

# Vercel Cron sends this as a Bearer token to /api/cron/tick.
CRON_SECRET=

# Composio project API key. Optional: COMPOSIO_AUTH_CONFIGS='{"googleads":"ac_..."}' to pin auth configs.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIGS=

# Base URL in emails. Default https://hirelooper.com.
LOOPER_URL=

# On-prem (deploy/enterprise): no Stripe, every plan feature, mail over SMTP, connectors to internal hosts.
LOOPER_EDITION=
SMTP_URL=
SMTP_FROM=
LOOPER_ALLOWED_EMAILS=
LOOPER_ALLOW_PRIVATE_HOSTS=
