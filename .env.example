# Everything is optional for a local, single-user install: `npm run dev` works with none of these.

# — Storage — Postgres (e.g. Supabase or Neon). Without it, data lives in ./data as JSON files.
DATABASE_URL=

# — Sessions — any long random string when hosting (locally one is generated in ./data).
SESSION_SECRET=

# — Sign-in with Google, GitHub and 6-digit email codes (Supabase Auth). Without these, the login
#   page offers ChatGPT (local only) and Grok sign-in instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Restrict who can sign in: "you@company.com,@company.com"
ALLOWED_EMAILS=

# — App connections (Gmail, Search Console, Buffer, GitHub, …) via Composio
COMPOSIO_API_KEY=

# — Each looper's computer (Vercel Sandbox). On Vercel this uses the project's OIDC token automatically;
#   elsewhere set VERCEL_TOKEN, VERCEL_TEAM_ID and VERCEL_PROJECT_ID.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# — Scheduler: a cron calls GET /api/tick with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Turn off the in-process minute ticker (local dev against a shared database)
GROKLOOPER_TICKER=

# — Hosted service only (hirelooper.com). Leave empty when self-hosting: billing and credits stay off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_TEAM=
# Claude key that pays for included credits
ANTHROPIC_API_KEY=
# Free hosted access for these owners' workspaces
COMP_EMAILS=
